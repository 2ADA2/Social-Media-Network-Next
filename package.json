{
  "name": "social-media-network-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "backend": "internship-backend serve social --port 4000",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "dev:all": "concurrently -n next,api \"npm:dev\" \"npm:backend\"",
    "docker:build": "docker build -t social-next .",
    "docker:run": "docker run -d -p 3000:3000 -p 4000:4000 --name social-next social-next",
    "docker:stop": "docker rm -f social-next",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^6.0.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@next/bundle-analyzer": "^16.4.3",
    "@react-spring/web": "^10.1.2",
    "@reduxjs/toolkit": "^2.13.0",
    "@sidekick-software/internship-backend": "file:packages/sidekick-software-internship-backend-0.1.0.tgz",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "apexcharts": "^8.5.0",
    "axios": "^1.20.0",
    "concurrently": "^10.0.6",
    "graphql-request": "^7.4.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-apexcharts": "^2.1.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-redux": "^9.3.0",
    "styled-components": "^6.6.0",
    "vite-plugin-svgr": "^5.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
